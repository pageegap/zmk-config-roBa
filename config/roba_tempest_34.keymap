// 34-key adaptation. Original roBa keymap is retained separately as roBa.keymap.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33
/ {
    behaviors {
        ht_left: left_homerow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        ht_right: right_homerow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };
    combos {
        compatible = "zmk,combos";
        tab { bindings = <&kp TAB>; key-positions = <11 12>; };
        shift_tab { bindings = <&kp LS(TAB)>; key-positions = <12 13>; };
        esc { bindings = <&kp ESC>; key-positions = <6 7>; timeout-ms = <50>; };
    };
    keymap {
        compatible = "zmk,keymap";
        BASE {
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
                &ht_left LCMD A  &ht_left LEFT_ALT S  &ht_left LCTRL D  &ht_left LSHFT F  &kp G  &kp H  &ht_right RSHFT J  &ht_right RCTRL K  &ht_right RALT L  &ht_right RCMD SEMICOLON
                &lt 1 Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &lt 2 SLASH
                &lt 3 BACKSPACE  &lt 5 SPACE  &lt 6 ENTER  &lt 4 DELETE
            >;
        };
        NUM {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3  &trans
                &trans  &trans  &kp LC(LS(TAB))  &kp LC(TAB)  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
                &trans  &kp LGUI  &mkp MB4  &mkp MB1  &mkp MB5  &trans  &kp N7  &kp N8  &kp N9  &kp N0
                &trans  &trans  &trans  &trans
            >;
        };
        SYM {
            bindings = <
                &kp SQT  &kp PERCENT  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp HASH  &kp PIPE  &kp AMPERSAND  &kp ASTERISK  &kp GRAVE  &trans
                &kp DQT  &kp AT_SIGN  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE  &kp EXCLAMATION  &kp EQUAL  &kp PLUS  &kp MINUS  &trans
                &kp NON_US_BACKSLASH  &kp LCTRL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOLLAR  &trans  &mkp MB1  &mkp MB2  &trans  &trans
                &trans  &trans  &trans  &trans
            >;
        };
        NAV {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &trans
                &kp F12  &kp F7  &kp F8  &kp F10  &trans  &trans  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT
                &mo 5  &mkp MB4  &mkp MB2  &mkp MB1  &mkp MB5  &trans  &trans  &kp HOME  &kp END  &trans
                &trans  &trans  &trans  &trans
            >;
        };
        MOUSE {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &mkp MB4  &mkp MB2  &mkp MB1  &mkp MB5  &mkp MB5  &mkp MB1  &mkp MB2  &mkp MB4  &trans
                &trans  &trans  &trans  &trans
            >;
        };
        SCROLL {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
            >;
        };
        SYS {
            bindings = <
                &trans  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &bootloader  &sys_reset  &studio_unlock  &trans  &trans  &trans  &trans  &trans  &sys_reset  &bootloader
                &bt BT_CLR  &trans  &trans  &bt BT_CLR
            >;
        };
    };
};
