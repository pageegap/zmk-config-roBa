// XIAO nRF52840 Plus; local column order is pinky, ring, middle, index, inner.
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include "roba_tempest_34-layout.dtsi"

/ {
    chosen { zmk,physical-layout = &rt34_layout; };

    rt34_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <10>;
        // Left is columns 0..4; right is columns 5..9, reversed visually.
        // Thumb order: left MID,FAR; right FAR,MID.
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
            RC(3,3) RC(3,4) RC(3,9) RC(3,8)
        >;
    };

    rt34_scan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>,
                    <&gpio1 14 GPIO_ACTIVE_HIGH>,
                    <&gpio1 13 GPIO_ACTIVE_HIGH>,
                    <&gpio1 12 GPIO_ACTIVE_HIGH>,
                    <&gpio0 15 GPIO_ACTIVE_HIGH>; // Plus D11, not NFC2.
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;
        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
        };
    };
    remote_trackball_listener: remote_trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;
        status = "disabled";
    };
};

// The Plus uses R16=1M and R17=499k, not the base board's 510k divider.
&vbatt {
    io-channels = <&adc 7>; // P0.31 / D16 is sensing only.
    power-gpios = <&gpio0 14 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW)>;
    output-ohms = <499000>;
    full-ohms = <1499000>;
};

// Matrix/sensor pins must not be claimed by the inherited UART/I2C/SPI2.
&xiao_serial { status = "disabled"; };
&i2c0 { status = "disabled"; };
&spi2 { status = "disabled"; };
// Internal MCU flash stores firmware/settings. External flash is unused;
// avoid inheriting a particular non-Plus flash chip's JEDEC assumptions.
&qspi { status = "disabled"; };
&gd25q16 { status = "disabled"; };
&p25q16h { status = "disabled"; };

&pinctrl {
    rt34_spi_default: rt34_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>; // roBa shared SDIO line.
        };
    };
    rt34_spi_sleep: rt34_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};
&spi0 {
    compatible = "nordic,nrf-spim";
    status = "disabled";
    pinctrl-0 = <&rt34_spi_default>;
    pinctrl-1 = <&rt34_spi_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>; // Plus D12, not NFC1.
    trackball: trackball@0 {
        compatible = "pixart,pmw3610";
        status = "disabled";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        // Layer-dependent processing is performed centrally for BOTH sensors.
        automouse-layer = <0>; // Zero disables the driver's preprocessor-gated automouse code.
    };
};
